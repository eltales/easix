#Requires -Version 5.1
Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

# =============================================================================
# Easix provisioning script (Windows PowerShell)
# Generated for: {{ profile.hostname }} ({{ profile.os }})
# =============================================================================

Write-Host "=== Easix provisioning started ===" -ForegroundColor Cyan

{% if not dis_system %}
{% if profile.hostname %}
# --- Hostname ---
Write-Host "[STEP] Hostname: setting to {{ profile.hostname }}..."
if ((hostname) -ne "{{ profile.hostname }}") {
    Rename-Computer -NewName "{{ profile.hostname }}" -Force -ErrorAction SilentlyContinue
    Write-Host "[OK] Hostname: {{ profile.hostname }} (reboot required to take effect)"
} else {
    Write-Host "[SKIP] Hostname: already {{ profile.hostname }}"
}
{% endif %}

{% if win_locale_tag %}
# --- Locale ---
Write-Host "[STEP] Locale: setting to {{ win_locale_tag }}..."
try {
    Set-WinSystemLocale -SystemLocale "{{ win_locale_tag }}"
    Set-WinUserLanguageList -LanguageList "{{ win_locale_tag }}" -Force
    Set-Culture -CultureInfo "{{ win_locale_tag }}"
    Write-Host "[OK] Locale: {{ win_locale_tag }} (reboot required for system locale to take effect)"
} catch {
    Write-Host "[WARN] Locale: could not set '{{ win_locale_tag }}' ($($_.Exception.Message))" -ForegroundColor Yellow
}
{% endif %}

{% if profile.system.timezone %}
# --- Timezone ---
Write-Host "[STEP] Timezone: setting to {{ profile.system.timezone }}..."
$_tz = "{{ profile.system.timezone }}"
$_tzMap = @{
    "UTC"             = "UTC"
    "Europe/Warsaw"   = "Central European Standard Time"
    "Europe/London"   = "GMT Standard Time"
    "Europe/Berlin"   = "W. Europe Standard Time"
    "Europe/Paris"    = "Romance Standard Time"
    "America/New_York"= "Eastern Standard Time"
    "America/Chicago" = "Central Standard Time"
    "America/Denver"  = "Mountain Standard Time"
    "America/Los_Angeles" = "Pacific Standard Time"
    "Asia/Tokyo"      = "Tokyo Standard Time"
    "Asia/Shanghai"   = "China Standard Time"
    "Australia/Sydney"= "AUS Eastern Standard Time"
}
$_winTz = if ($_tzMap.ContainsKey($_tz)) { $_tzMap[$_tz] } else { "UTC" }
try { Set-TimeZone -Name $_winTz -ErrorAction Stop; Write-Host "[OK] Timezone: $_winTz" }
catch { Write-Host "[WARN] Timezone: could not set '$_winTz'" -ForegroundColor Yellow }
{% endif %}

{% if profile.system.ntp %}
# --- NTP ---
Write-Host "[STEP] NTP: configuring Windows Time service..."
if ((Get-Service w32tm -ErrorAction SilentlyContinue).Status -ne "Running") {
    Start-Service w32tm -ErrorAction SilentlyContinue
    Set-Service w32tm -StartupType Automatic
}
w32tm /config /manualpeerlist:"pool.ntp.org" /syncfromflags:manual /update 2>&1 | Out-Null
Write-Host "[OK] NTP: Windows Time service configured"
{% endif %}

{% if profile.system.swap_mb %}
# --- Pagefile (virtual memory) ---
Write-Host "[STEP] Pagefile: setting size to {{ profile.system.swap_mb }}MB..."
try {
    $_computerSys = Get-WmiObject Win32_ComputerSystem -EnableAllPrivileges
    if ($_computerSys.AutomaticManagedPagefile) {
        $_computerSys.AutomaticManagedPagefile = $false
        $_computerSys.Put() | Out-Null
    }
    $_pageFile = Get-WmiObject Win32_PageFileSetting | Select-Object -First 1
    if ($_pageFile) {
        $_pageFile.InitialSize = {{ profile.system.swap_mb }}
        $_pageFile.MaximumSize = {{ profile.system.swap_mb }}
        $_pageFile.Put() | Out-Null
    } else {
        Set-WmiInstance -Class Win32_PageFileSetting -Arguments @{
            Name        = "C:\pagefile.sys"
            InitialSize = {{ profile.system.swap_mb }}
            MaximumSize = {{ profile.system.swap_mb }}
        } | Out-Null
    }
    Write-Host "[OK] Pagefile: {{ profile.system.swap_mb }}MB configured (reboot required to take effect)"
} catch {
    Write-Host "[WARN] Pagefile: could not configure ($($_.Exception.Message))" -ForegroundColor Yellow
}
{% endif %}

{% if profile.system.enable_tpm %}
# --- TPM 2.0 ---
Write-Host "[STEP] TPM: verifying status (required for Windows 11)..."
try {
    $_tpm = Get-Tpm
    if ($_tpm.TpmPresent) {
        Write-Host "[OK] TPM: present (Ready=$($_tpm.TpmReady), Enabled=$($_tpm.TpmEnabled), Activated=$($_tpm.TpmActivated))"
        if (-not $_tpm.TpmReady) {
            Write-Host "[WARN] TPM: present but not ready — check BIOS/UEFI TPM settings" -ForegroundColor Yellow
        }
    } else {
        Write-Host "[WARN] TPM: not detected — required for Windows 11" -ForegroundColor Yellow
    }
} catch {
    Write-Host "[WARN] TPM: could not query status ($($_.Exception.Message))" -ForegroundColor Yellow
}
{% endif %}
{% endif %}

{% if not dis_packages %}
{% if profile.packages | length > 0 %}
# --- Software installation ---
if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Host "[WARN] winget not available — install App Installer from Microsoft Store" -ForegroundColor Yellow
}

{% for item in profile.packages %}
# --- {{ item.name }} [{{ item.task_type }}] ---
Write-Host "[STEP] {{ item.task_type }}: {{ item.name }}..."
{% if item.check_cmd %}
$_easixSkip = $false
try { $null = Invoke-Expression "{{ item.check_cmd }}"; if ($LASTEXITCODE -eq 0 -or $?) { $_easixSkip = $true } } catch {}
{% elif item.task_type == "package" %}
$_easixSkip = $false
if (Get-Command "{{ item.name }}" -ErrorAction SilentlyContinue) { $_easixSkip = $true }
{% elif item.task_type == "service" %}
$_easixSkip = $false
if ((Get-Service "{{ item.name }}" -ErrorAction SilentlyContinue).Status -eq "Running") { $_easixSkip = $true }
{% elif item.task_type == "user" %}
$_easixSkip = $false
if (Get-LocalUser "{{ item.name }}" -ErrorAction SilentlyContinue) { $_easixSkip = $true }
{% elif item.task_type == "file" %}
$_easixSkip = $false
if (Test-Path "{{ item.name }}") { $_easixSkip = $true }
{% else %}
$_easixSkip = $false
{% endif %}
if ($_easixSkip) {
    Write-Host "[SKIP] {{ item.name }}: already in desired state" -ForegroundColor DarkGray
} else {
{% for cmd in item.commands %}
    Invoke-Expression "{{ cmd }}"
    if ($LASTEXITCODE -and $LASTEXITCODE -ne 0) { throw "[ERROR] {{ item.name }}: command failed: {{ cmd }}" }
{% endfor %}
    Write-Host "[OK] {{ item.name }}" -ForegroundColor Green
}
{% endfor %}
{% endif %}
{% endif %}

{% if not dis_user %}
# --- Local User ---
Write-Host "[STEP] User: configuring '{{ profile.user.name }}'..."
if (-not (Get-LocalUser "{{ profile.user.name }}" -ErrorAction SilentlyContinue)) {
{% if profile.user.initial_password %}
    $pass = ConvertTo-SecureString "{{ profile.user.initial_password }}" -AsPlainText -Force
    New-LocalUser "{{ profile.user.name }}" -Password $pass -PasswordNeverExpires
    Write-Host "[OK] User: '{{ profile.user.name }}' created"
{% else %}
    $pass = ConvertTo-SecureString "ChangeMe123!" -AsPlainText -Force
    New-LocalUser "{{ profile.user.name }}" -Password $pass -PasswordNeverExpires
    Write-Host "[OK] User: '{{ profile.user.name }}' created (password: ChangeMe123! — change immediately!)"
{% endif %}
} else {
    Write-Host "[SKIP] User: '{{ profile.user.name }}' already exists"
}
{% if profile.user.sudo %}
Add-LocalGroupMember -Group "Administrators" -Member "{{ profile.user.name }}" -ErrorAction SilentlyContinue
Write-Host "[OK] User: '{{ profile.user.name }}' added to Administrators"
{% endif %}
{% endif %}

{% if not dis_network %}
{% if profile.network.mode == "static" and profile.network.address %}
# --- Network (static) ---
Write-Host "[STEP] Network: configuring static IP {{ profile.network.address }}..."
try {
    $_adapter = Get-NetAdapter | Where-Object { $_.Status -eq "Up" } | Select-Object -First 1
    if (-not $_adapter) { throw "no active network adapter found" }
    $_parts = "{{ profile.network.address }}" -split "/"
    $_ip = $_parts[0]
    $_prefix = if ($_parts.Length -gt 1) { [int]$_parts[1] } else { 24 }
    Get-NetIPAddress -InterfaceIndex $_adapter.ifIndex -AddressFamily IPv4 -ErrorAction SilentlyContinue |
        Remove-NetIPAddress -Confirm:$false -ErrorAction SilentlyContinue
{% if profile.network.gateway %}
    New-NetIPAddress -InterfaceIndex $_adapter.ifIndex -IPAddress $_ip -PrefixLength $_prefix -DefaultGateway "{{ profile.network.gateway }}" -ErrorAction Stop | Out-Null
{% else %}
    New-NetIPAddress -InterfaceIndex $_adapter.ifIndex -IPAddress $_ip -PrefixLength $_prefix -ErrorAction Stop | Out-Null
{% endif %}
{% if profile.network.dns %}
    Set-DnsClientServerAddress -InterfaceIndex $_adapter.ifIndex -ServerAddresses "{{ profile.network.dns }}"
{% endif %}
    Write-Host "[OK] Network: static IP $_ip/$_prefix configured on $($_adapter.Name)"
} catch {
    Write-Host "[WARN] Network: could not configure static IP ($($_.Exception.Message))" -ForegroundColor Yellow
}
{% endif %}
{% endif %}

{% if not dis_security %}
{% if profile.security.firewall == "enabled" %}
# --- Firewall ---
Write-Host "[STEP] Firewall: enabling Windows Defender Firewall (deny incoming, allow SSH)..."
Set-NetFirewallProfile -Profile Domain,Public,Private -Enabled True -DefaultInboundAction Block -DefaultOutboundAction Allow
New-NetFirewallRule -DisplayName "Easix-AllowSSH" -Direction Inbound -Protocol TCP -LocalPort 22 -Action Allow -ErrorAction SilentlyContinue | Out-Null
Write-Host "[OK] Firewall: all profiles enabled (deny incoming, SSH allowed)"
{% elif profile.security.firewall == "disabled" %}
# --- Firewall ---
Write-Host "[STEP] Firewall: disabling Windows Defender Firewall..."
Set-NetFirewallProfile -Profile Domain,Public,Private -Enabled False
Write-Host "[OK] Firewall: all profiles disabled"
{% endif %}
{% if profile.security.ssh_key %}
# --- SSH key ---
Write-Host "[STEP] SSH key: deploying for {{ profile.user.name }}..."
{% if profile.user.sudo %}
$_sshAdminDir = "C:\ProgramData\ssh"
if (-not (Test-Path $_sshAdminDir)) { New-Item -ItemType Directory -Path $_sshAdminDir -Force | Out-Null }
$_adminKeysFile = "$_sshAdminDir\administrators_authorized_keys"
Add-Content -Path $_adminKeysFile -Value "{{ profile.security.ssh_key }}"
icacls $_adminKeysFile /inheritance:r | Out-Null
icacls $_adminKeysFile /grant "Administrators:F" | Out-Null
icacls $_adminKeysFile /grant "SYSTEM:F" | Out-Null
Write-Host "[OK] SSH key: deployed to $_adminKeysFile (administrators file, required for admin accounts)"
{% else %}
$_sshDir = "C:\Users\{{ profile.user.name }}\.ssh"
if (-not (Test-Path $_sshDir)) { New-Item -ItemType Directory -Path $_sshDir -Force | Out-Null }
Add-Content -Path "$_sshDir\authorized_keys" -Value "{{ profile.security.ssh_key }}"
Write-Host "[OK] SSH key: deployed to $_sshDir\authorized_keys"
{% endif %}
{% endif %}
{% endif %}

{% for script in profile.custom_scripts %}
{% if script.mode == "run_once" %}
# --- Custom script: {{ script.name }} (run once) ---
Write-Host "[STEP] Script '{{ script.name }}': executing..."
$_tmpScript = "$env:TEMP\easix-{{ script.name }}.ps1"
Set-Content -Path $_tmpScript -Value @'
{{ script.content }}
'@
& $_tmpScript
Remove-Item -Path $_tmpScript -Force -ErrorAction SilentlyContinue
Write-Host "[OK] Script '{{ script.name }}': executed and removed"
{% elif script.mode == "autostart" %}
# --- Custom script: {{ script.name }} (scheduled task) ---
Write-Host "[STEP] Script '{{ script.name }}': installing as startup scheduled task..."
$_scriptPath = "C:\easix\scripts\{{ script.name }}.ps1"
if (-not (Test-Path "C:\easix\scripts")) { New-Item -ItemType Directory -Path "C:\easix\scripts" -Force | Out-Null }
Set-Content -Path $_scriptPath -Value @'
{{ script.content }}
'@
$_action  = New-ScheduledTaskAction -Execute "PowerShell.exe" -Argument "-ExecutionPolicy Bypass -File `"$_scriptPath`""
$_trigger = New-ScheduledTaskTrigger -AtStartup
Register-ScheduledTask -TaskName "easix-{{ script.name }}" -Action $_action -Trigger $_trigger -RunLevel Highest -Force | Out-Null
Write-Host "[OK] Script '{{ script.name }}': registered as scheduled task 'easix-{{ script.name }}'"
{% endif %}
{% endfor %}

Write-Host "=== Easix provisioning completed ===" -ForegroundColor Cyan
